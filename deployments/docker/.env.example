# Local development only.
#
# `make env` copies this file to deployments/docker/.env, which is gitignored.
# Every value here is a throwaway placeholder for a stack bound to 127.0.0.1.
# None of it is a credential — do not reuse any of it anywhere real, and do not
# expose this stack beyond localhost.

# PostgreSQL
DB_NAME=opentams
DB_USER=opentams
DB_PASSWORD=local-dev-only-change-me

# MinIO (S3-compatible object store)
OBJECT_STORE_BUCKET=opentams
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=local-dev-only-access-key
OBJECT_STORE_SECRET_ACCESS_KEY=local-dev-only-secret-key

# Storage backend
STORAGE_BACKEND_PROVIDER=s3
